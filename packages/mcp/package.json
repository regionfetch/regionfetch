{
  "name": "regionfetch-mcp",
  "version": "0.1.1",
  "description": "MCP server for Region Fetch \u2014 paid geo-targeted web retrieval with signed Ed25519 receipts.",
  "mcpName": "io.github.regionfetch/regionfetch-mcp",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "regionfetch",
    "x402",
    "geo",
    "fetch",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regionfetch/regionfetch.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/regionfetch/regionfetch/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/regionfetch/regionfetch/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "regionfetch-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp-test",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test $(find .tmp-test/test -name \"*.test.js\")",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.24.0",
    "@x402/evm": "^2.24.0",
    "regionfetch": "^0.1.0",
    "viem": "^2.48.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^20.19.0"
  }
}
